# Environment Configuration Example
# Copy this file to .env and fill in your values

# LLM Configuration
# Default: huggingface (no setup needed, runs locally)
# Options: huggingface, openai, ollama
LLM_TYPE=huggingface

# OpenAI Configuration (only if LLM_TYPE=openai)
# OPENAI_API_KEY=sk-your-api-key-here
# OPENAI_MODEL=gpt-3.5-turbo

# Ollama Configuration (only if LLM_TYPE=ollama)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=mistral

# API Configuration
API_HOST=127.0.0.1
API_PORT=8000
API_RELOAD=True

# Logging
LOG_LEVEL=INFO

# Document Processing
CHUNK_SIZE=500
CHUNK_OVERLAP=100
TOP_K_RESULTS=3
